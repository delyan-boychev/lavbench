# TLS server fragment — activated only when certificates are present.
# The frontend entrypoint copies this file to ssl.conf (enabling the 443
# listener) iff /etc/nginx/ssl/lavbench.crt exists. Otherwise HTTP-only.
server {
    listen 443 ssl;
    server_name localhost;
    # Match the backend's task-upload ceiling; sensitive JSON endpoints enforce
    # Much smaller request limits before parsing
    client_max_body_size 2G;

    ssl_certificate     /etc/nginx/ssl/lavbench.crt;
    ssl_certificate_key /etc/nginx/ssl/lavbench.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /dev/stdout;
    access_log /app/logs/nginx_access.log;
    error_log /dev/stderr;
    error_log /app/logs/nginx_error.log;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /api {
        proxy_pass http://backend:5001/api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        chunked_transfer_encoding off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /apidoc {
        proxy_pass http://backend:5001/apidoc;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
