# TLS server fragment — activated only when certificates are present.
# The frontend entrypoint copies this file to ssl.conf (enabling the 443
# listener) iff /etc/nginx/ssl/lavbench.crt exists. Otherwise HTTP-only.
server {
    listen 443 ssl;
    # HTTP/2 multiplexes every SSE stream over one connection, so several tabs
    # no longer exhaust the browser's 6-connection HTTP/1.1 limit
    http2 on;
    server_name localhost;
    # Default request body cap. Only the admin upload, notebook parse and worker
    # report locations inside /api raise it; the backend enforces each route's limit
    client_max_body_size 10m;

    # Answer oversized bodies in the API's error shape instead of nginx's HTML page
    error_page 413 = @request_too_large;
    location @request_too_large {
        default_type application/json;
        return 413 '{"error": "Request payload too large", "code": "ERR_PAYLOAD_TOO_LARGE"}';
    }

    ssl_certificate     /etc/nginx/ssl/lavbench.crt;
    ssl_certificate_key /etc/nginx/ssl/lavbench.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Access log to stdout only, where Docker's json-file driver rotates it
    access_log /dev/stdout;
    # Error log to stderr only, rotated by Docker like the access log
    error_log /dev/stderr;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /api {
        proxy_pass http://backend:5001/api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        chunked_transfer_encoding off;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        # Admin multipart uploads, up to 2 GB: task create and update with
        # files, challenge ZIP import and competitor CSV import. This nested
        # location inherits every proxy setting above. proxy_pass is repeated
        # without a URI part because nginx forbids one in regex locations; the
        # request URI then passes through unchanged
        location ~ "^/api/(challenges/[0-9a-fA-F-]{36}/tasks|tasks/[0-9a-fA-F-]{36}|challenges/import|admin/import-competitors-csv)$" {
            client_max_body_size 2g;
            proxy_pass http://backend:5001;
        }

        # Competitors upload their notebook to pick cells from it; saved outputs
        # (plots, images) easily push an .ipynb past the 10 MB default. The backend
        # allows MAX_NOTEBOOK_BYTES (16 MiB); this adds room for the multipart framing
        location ~ "^/api/challenges/[0-9a-fA-F-]{36}/parse-notebook$" {
            client_max_body_size 17m;
            proxy_pass http://backend:5001;
        }

        # Evaluation workers post results and logs here. The backend truncates
        # logs on receipt, but a verbose run's report can exceed the default cap
        location ~ "^/api/(worker/|workers/logs$)" {
            client_max_body_size 100m;
            proxy_pass http://backend:5001;
        }
    }

    location /apidoc {
        proxy_pass http://backend:5001/apidoc;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
