{
  "name": "lavbench-frontend",
  "private": true,
  "version": "1.1.1",
  "description": "Sandboxed code evaluation platform — frontend",
  "author": "Bulgarian AI Olympiad Committee",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/delyan-boychev/lavbench",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delyan-boychev/lavbench.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:comments": "eslint -c eslint.comments.config.js .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check-types": "tsc --noEmit",
    "audit:security": "node scripts/check-npm-audit.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json,md}\"",
    "generate-api-types": "openapi-typescript \"${API_SPEC_URL:-http://localhost:5001/apidoc/openapi.json}\" -o src/types/api.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.3.0",
    "i18next-http-backend": "^4.0.10",
    "lucide-react": "^1.72.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-markdown": "^10.1.0",
    "react-router": "8.5.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "happy-dom": "^20.11.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "^5.8.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.0"
  }
}
