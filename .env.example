# ═══════════════════════════════════════════════════════════════
#  LavBench Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Run: make setup  →  auto-generates all keys and creates .env
# ═══════════════════════════════════════════════════════════════
# Docker Compose (2.24 or later) reads this file twice: for ${VAR}
# interpolation in docker-compose.yml, and as container environment
# (env_file) for the backend. Beat and the internal worker only receive
# the settings docker-compose.yml lists for them, so secrets never reach
# them. The compose file sets the in-network URLs and roles itself, so the
# localhost URLs below only apply to `make dev`.

# ── REQUIRED (must be set) ──────────────────────────────────────
# Flask secret key — used for JWT signing and session encryption
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Independent root secret for unpredictable public/private evaluation splits.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
EVALUATION_SPLIT_SECRET=

# PostgreSQL database identity and password
POSTGRES_USER=lavbench_user
POSTGRES_PASSWORD=
POSTGRES_DB=lavbench_db

# Fernet key for PII encryption at rest (allows SECRET_KEY rotation)
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Independent Fernet key shipped to remote workers via worker.env (defaults to
# ENCRYPTION_KEY). Workers must NEVER receive SECRET_KEY — a compromised eval
# worker must not be able to mint JWTs or decrypt server-side PII.
WORKER_ENCRYPTION_KEY=

# ── Database ────────────────────────────────────────────────────
# Connection string for PostgreSQL.
# For local dev: localhost
# For Docker Compose: the service name 'db' is used automatically
DATABASE_URL=postgresql://lavbench_user:${POSTGRES_PASSWORD}@localhost:5432/lavbench_db

# Connection pool per process (every gunicorn worker and Celery process has its own)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# Web process only: abort a transaction left idle this long (milliseconds); a
# backstop for leaked transactions, long enough for large multipart uploads
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=300000
# Abort any single SQL statement that runs longer than this (milliseconds)
# PG_STATEMENT_TIMEOUT_MS=30000

# ── Redis (message broker + cache) ──────────────────────────────
# Used by Celery for task queuing and SSE pub/sub.
# For local dev: localhost
# For Docker Compose: the service name 'redis' is used automatically

# Redis password — auto-generated by make setup (defined before URLs that reference it)
REDIS_PASSWORD=

CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
# Largest notebook accepted for cell selection (bytes, default 16 MiB)
# MAX_NOTEBOOK_BYTES=16777216

# Celery limits for one evaluation (image build plus run). Task time limits are
# capped at the soft limit minus 60 s. Set the same values in every worker.env:
# the worker enforces them
# CELERY_TASK_SOFT_TIME_LIMIT=1200
# CELERY_TASK_TIME_LIMIT=1500
# Broker expiry of queued evaluation messages (seconds). Keep it at least 15 min
# below the 1 h watchdog cutoff, which leaves time for the image build
# CELERY_MESSAGE_EXPIRES=2700
# Redelivery timeout for an unacknowledged message (seconds); must exceed the
# 1 h watchdog cutoff so a queued evaluation is never delivered twice
# CELERY_VISIBILITY_TIMEOUT=7200
# Queued plus running evaluations per queue before submits get ERR_QUEUE_FULL
# MAX_QUEUED_EVALUATIONS=100

# Dedicated cache instance (DB 1) — compose runs a separate redis-cache container
# wired to this URL; this localhost value is used by `make dev`.
CACHE_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/1

# Broker socket timeouts (seconds)
# CELERY_BROKER_SOCKET_TIMEOUT=10
# CELERY_BROKER_SOCKET_CONNECT_TIMEOUT=3

# Redis protocol — 'redis' (plain) or 'rediss' (TLS). Set by make setup.
REDIS_PROTO=redis

# Redis bind address — loopback by default for security; set to 0.0.0.0 only
# when remote evaluation workers need to reach the broker.
REDIS_BIND=127.0.0.1

# Redis data limits leave additional container memory for process overhead.
# When full, the broker refuses writes (noeviction) and the cache evicts keys
# that carry a TTL (volatile-lru).
# REDIS_BROKER_MAXMEMORY=256mb
# REDIS_BROKER_CONTAINER_MEMORY=384m
# REDIS_CACHE_MAXMEMORY=128mb
# REDIS_CACHE_CONTAINER_MEMORY=256m
# REDIS_HEALTH_MIN_FREE_PERCENT=10

# Redis client connection timeouts (seconds)
# REDIS_SOCKET_CONNECT_TIMEOUT=5
# REDIS_SOCKET_TIMEOUT=5

# ── Redis TLS (only for rediss:// connections) ──────────────────
# Place certificate files in ./certs/ — they are mounted into
# Docker containers automatically.
# REDIS_SSL_CA_CERTS=/etc/ssl/certs/redis/redis-ca.crt
# REDIS_SSL_CERTFILE=/etc/ssl/certs/redis/redis-client.crt
# REDIS_SSL_KEYFILE=/etc/ssl/certs/redis/redis-client.key
# REDIS_SSL_CERT_REQS=required

# ── Worker Authentication ───────────────────────────────────────
# Registered Ed25519 public keys. Each worker.env contains one matching
# WORKER_ID and WORKER_PRIVATE_KEY; never share private keys between workers.
SERVER_ADDRESS=localhost
# Address eval workers call back on: the nginx front end (port 80, or https:// with TLS).
# The backend's own port 5001 is not published outside the compose network
MAIN_SERVER_URL=http://${SERVER_ADDRESS}
WORKER_PUBLIC_KEYS_JSON={}
WORKER_CAPABILITY_SECRET=
# WORKER_CAPABILITY_TTL=3600
# WORKER_ATTEMPT_LEASE_TTL=1500

# ── Server URL configuration (set by make setup) ────────────────
# Host port mapped to the nginx/frontend container (80 for HTTP, 443 for HTTPS)
# NGINX_PORT=80
# Host port for the TLS listener — the frontend enables 443 automatically when
# self-signed certs exist in certs/web/ (generated by make setup → HTTPS).
# HTTPS_PORT=443

# ── Worker Identity & Mode ──────────────────────────────────────
# Process role: server = full API (default); scheduler = Celery beat only, no app
# and no secrets; internal = system-task worker (DB only, never evaluates);
# eval = remote evaluation worker (no DB, Ed25519 auth). Compose and the worker
# scripts set it per container
# WORKER_ROLE=server
# Comma-separated GPU device ids this eval worker may use (written by setup-worker.sh).
# Each GPU sandbox locks one free device and pins it; unset means count=-1 (every GPU)
# WORKER_GPU_ID=0

# ── Worker Heartbeat & Status ───────────────────────────────────
# How often each worker refreshes its heartbeat (seconds)
# WORKER_HEARTBEAT_SECONDS=30
# A worker whose last heartbeat is older than this counts as offline (seconds)
# WORKER_HEARTBEAT_STALE_SECONDS=90
# How long GET /api/status caches its result (seconds)
# STATUS_CACHE_SECONDS=30
# Scoring shows as degraded once the oldest queued submission waits this long (seconds)
# STATUS_QUEUE_DEGRADED_SECONDS=600

# ── Worker Sandbox Resources ────────────────────────────────────
# GPU_RAM_PER_TASK_GB=8
# CPU_RAM_PER_TASK_GB=8
# RESERVED_RAM_GB=4
# RESERVED_CPU_CORES=1
# RAM_CLAMP_FACTOR=1.05
# CPU cores per sandbox; 0 means every core except RESERVED_CPU_CORES
# CPU_CORES_PER_TASK=0
# GPU_CORES_PER_TASK=0
# How long a GPU run waits for a free device before failing (seconds)
# GPU_ACQUISITION_TIMEOUT=600

# Compose-level caps applied to the celery_worker container:
# hard memory/CPU ceilings and no capabilities / no-new-privileges.
# WORKER_MEM_LIMIT=1g
# WORKER_CPU_LIMIT=2

# Mandatory container root writable-layer quota. Docker must support per-container
# storage-opt; the separate disposable anonymous volume at /app is not covered.
# WORKER_SANDBOX_STORAGE_OPT=8g

# ── Worker HTTP Client (reports / downloads) ────────────────────
# WORKER_MAX_LOG_LINES=10000
# WORKER_MAX_STDOUT_CHARS=1048576
# WORKER_REPORT_MAX_RETRIES=3
# WORKER_REPORT_TIMEOUT=10
# WORKER_DOWNLOAD_TIMEOUT=30
# MAX_WORKER_REPORT_BYTES=524288
# MAX_WORKER_AUTH_BODY_BYTES=8192
# MAX_WORKER_LOG_SHIP_BYTES=1048576
# MAX_COLLECT_BUFFER_BYTES=536870912
# MAX_EXTRACT_MEMBER_BYTES=536870912
# MAX_PARQUET_FILE_BYTES=536870912
# MAX_PARQUET_UNCOMPRESSED_BYTES=1073741824
# MAX_PARQUET_ROWS=10000000
# MAX_PARQUET_COLUMNS=512
# MAX_EVALUATOR_RESULT_BYTES=65536
# A custom evaluator runs as a limited subprocess on the worker: wall-clock limit (seconds)
# and memory limit (MiB)
# CUSTOM_EVALUATOR_TIME_LIMIT_SECONDS=300
# CUSTOM_EVALUATOR_MEMORY_MB=1024
# Upper bound for a worker-reported execution time; larger reports are rejected
# MAX_EXECUTION_TIME_MS=2592000000
# Decode caps for the pixel-mask metric, checked before any pixel data is read
# MAX_MASK_IMAGE_PIXELS=52428800
# MAX_MASK_IMAGE_DIM=16384

# Submission code limits (checked before AST parsing and again at persistence)
# MAX_SELECTED_CELLS=500
# MAX_CODE_CELL_CHARS=1048576
# MAX_CODE_CELLS_CHARS=5242880
# MAX_SUBMISSION_REQUEST_BYTES=6291456

# ── Server-Sent Events (SSE) ────────────────────────────────────
# SSE_MAX_PER_USER=15
# SSE_MAX_GLOBAL=2000
# SSE_IDLE_TIMEOUT=1800
# Per-submission log replay buffer in the cache Redis: lifetime (seconds) and line cap
# SSE_LOG_TTL=3600
# SSE_LOG_MAX_LINES=500
# Retry hint sent to EventSource clients, in milliseconds (jittered by 30%)
# SSE_RETRY_MS=5000
# Maximum bytes per live log line; longer lines are truncated
# SSE_LOG_MAX_LINE_BYTES=8192

# ── Security ────────────────────────────────────────────────────
# Set True when serving behind HTTPS (enables secure cookies). Production
# default in docker-compose is true. Only keep false for isolated LAN HTTP.
# SECURE_COOKIES=true

# ── Admin Tools ─────────────────────────────────────────────────
# USER_SEARCH_LIMIT=500
# AUDIT_LOG_YIELD_PER=500

# ── Backup ──────────────────────────────────────────────────────
# BACKUPS_DIR=/backups
# MIN_BACKUP_DISK_GB=1
# BACKUP_TIMEOUT=600
# Time limit (seconds) for writing the backup archive (the larger of this and BACKUP_TIMEOUT)
# BACKUP_UPLOADS_TIMEOUT=3600
# Automatic full backups kept; older ones are deleted
# BACKUP_RETENTION_COUNT=3
# Automatic database-only backups kept (18 x 20 min = the 6 h between full backups)
# BACKUP_DB_RETENTION_COUNT=18
# During a contest the database is backed up every 20 min, the uploads folder
# only this often (seconds)
# BACKUP_UPLOADS_INTERVAL_SECONDS=21600

# ── Image Builder (Docker) ──────────────────────────────────────
# TASK_IMAGES_DIR=./backend/task_images

# ── Application Defaults ────────────────────────────────────────
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:80

# Flask debug mode (never true in production)
FLASK_DEBUG=false

# HuggingFace dataset cache directory
HF_CACHE_DIR=./backend/hf_cache

# Upload storage path
# UPLOAD_FOLDER=./backend/uploads
# Challenge ZIP import limits.
# CHALLENGE_ARCHIVE_MAX_COMPRESSED_BYTES=209715200  # bytes (200 MiB)
# CHALLENGE_ARCHIVE_MAX_UNCOMPRESSED_BYTES=2147483648  # bytes (2 GiB)
# CHALLENGE_ARCHIVE_MAX_MEMBER_BYTES=524288000  # bytes (500 MiB)
# CHALLENGE_ARCHIVE_MAX_MEMBERS=1000  # entries
# CHALLENGE_ARCHIVE_MAX_COMPRESSION_RATIO=100  # 100:1 maximum

# Workspace directory for evaluation sandboxes
# LAVBENCH_WORKSPACE_DIR=./backend/workspace

# Celery worker concurrency (per worker node)
# CELERY_WORKER_CONCURRENCY=4

# Pagination
# DEFAULT_PER_PAGE=10
# MAX_PER_PAGE=100

# Cache TTL (seconds)
# CACHE_TIMEOUT=300

# Task metadata defaults
# DEFAULT_TIME_LIMIT_SEC=300
# DEFAULT_RAM_LIMIT_MB=8192
# DEFAULT_PUBLIC_EVAL_PERCENTAGE=30

# Grace period after a stage or challenge deadline (seconds): submissions are
# accepted until the deadline plus this, and nanoColab keeps workspaces open until then
# DEADLINE_GRACE_PERIOD_SECONDS=180

# ── nanoColab workspaces ────────────────────────────────────────
# Base URL of the nanoColab /v1 API; leave unset to turn workspaces off
# NANOCOLAB_API_URL=https://nanocolab.example.org
# File holding the ncak_<key id>_<secret> API key; Docker Compose mounts ./secrets read-only
# NANOCOLAB_API_KEY_FILE=/run/secrets/lavbench/nanocolab_api_key
# Timeout of every nanoColab call (seconds)
# NANOCOLAB_TIMEOUT_SECONDS=10
# Development only: allow plain http to localhost for the API and upload URLs
# NANOCOLAB_ALLOW_INSECURE_HTTP=false
# How often the internal worker syncs every enabled environment (seconds)
# NANOCOLAB_SYNC_INTERVAL_SECONDS=60
# A cached readiness older than this shows as "Unknown" (seconds)
# NANOCOLAB_STATUS_STALE_SECONDS=180
# Largest workspace package (bytes, 2 GiB; nanoColab's own limit)
# NANOCOLAB_PACKAGE_MAX_BYTES=2147483648
# "Publish automatically" publishes this many hours before the start
# NANOCOLAB_AUTO_PUBLISH_LEAD_HOURS=24
# Workspaces allowed per environment: registered students plus this percentage (at least 2)
# NANOCOLAB_ATTENDANCE_HEADROOM_PERCENT=5
# The admin status chip raises an alert after the environment prepares this long (minutes)
# NANOCOLAB_PREPARING_ALERT_MINUTES=10
# Largest submission.parquet or solution.ipynb taken from a workspace, and largest
# emergency upload (bytes, 20 MiB)
# NANOCOLAB_EXPORT_MAX_BYTES=20971520
# Read timeout of one workspace file export (seconds)
# NANOCOLAB_EXPORT_TIMEOUT_SECONDS=30

# ── Logging ────────────────────────────────────────────────────
# Directory for application logs (rotated daily, kept 6 days)
# LOG_DIR=/app/logs

# URL for remote workers to ship logs (leave empty to disable)
# WORKER_LOG_SHIP_URL=
# Size at which the server rotates worker_remote.log (kept as .1)
# MAX_WORKER_LOG_BYTES=10485760
# Characters of a stored submission log returned when it is read back
# MAX_LOG_CHARS=102400

# ── Gunicorn (server) ──────────────────────────────────────────
# Requests per worker before gunicorn recycles it. 0 disables recycling,
# because a recycle drops every SSE stream open on that worker.
# GUNICORN_MAX_REQUESTS=0
# GUNICORN_MAX_REQUESTS_JITTER=2000
# File descriptor limit (for 300+ concurrent users)
# GUNICORN_ULIMIT_NOFILE=65536
# Access and error logs; "-" is stdout, which Docker captures and rotates
# GUNICORN_ACCESS_LOGFILE=-
# GUNICORN_ERROR_LOGFILE=-
# Backend container caps. BACKEND_CPUS must be a whole number; a value above
# the host's CPU count is accepted and then allows every CPU.
# BACKEND_CPUS=4
# BACKEND_MEMORY=3g
