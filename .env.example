# ═══════════════════════════════════════════════════════════════
#  LavBench Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Run: make setup  →  auto-generates all keys and creates .env
# ═══════════════════════════════════════════════════════════════

# ── REQUIRED (must be set) ──────────────────────────────────────
# Flask secret key — used for JWT signing and session encryption
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL password for the application user
POSTGRES_PASSWORD=

# Fernet key for PII encryption at rest (allows SECRET_KEY rotation)
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Independent Fernet key shipped to remote workers via worker.env (defaults to
# ENCRYPTION_KEY). Workers must NEVER receive SECRET_KEY — a compromised eval
# worker must not be able to mint JWTs or decrypt server-side PII.
WORKER_ENCRYPTION_KEY=

# ── Database ────────────────────────────────────────────────────
# Connection string for PostgreSQL.
# For local dev: localhost
# For Docker Compose: the service name 'db' is used automatically
DATABASE_URL=postgresql://lavbench_user:${POSTGRES_PASSWORD}@localhost:5432/lavbench_db

# ── Redis (message broker + cache) ──────────────────────────────
# Used by Celery for task queuing and SSE pub/sub.
# For local dev: localhost
# For Docker Compose: the service name 'redis' is used automatically

# Redis password — auto-generated by make setup (defined before URLs that reference it)
REDIS_PASSWORD=

CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
CELERY_RESULT_BACKEND=${CELERY_BROKER_URL}
# CELERY_RESULT_EXPIRES=3600

# Dedicated cache instance (DB 1) — compose runs a separate redis-cache container
# wired to this URL; this localhost value is used by `make dev`.
CACHE_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/1

# Broker socket timeouts (seconds)
# CELERY_BROKER_SOCKET_TIMEOUT=10
# CELERY_BROKER_SOCKET_CONNECT_TIMEOUT=3

# Redis protocol — 'redis' (plain) or 'rediss' (TLS). Set by make setup.
REDIS_PROTO=redis

# Redis bind address — loopback by default for security; set to 0.0.0.0 only
# when remote evaluation workers need to reach the broker.
REDIS_BIND=127.0.0.1

# Redis client connection timeouts (seconds)
# REDIS_SOCKET_CONNECT_TIMEOUT=5
# REDIS_SOCKET_TIMEOUT=5

# ── Redis TLS (only for rediss:// connections) ──────────────────
# Place certificate files in ./certs/ — they are mounted into
# Docker containers automatically.
# REDIS_SSL_CA_CERTS=/etc/ssl/certs/redis/redis-ca.crt
# REDIS_SSL_CERTFILE=/etc/ssl/certs/redis/redis-client.crt
# REDIS_SSL_KEYFILE=/etc/ssl/certs/redis/redis-client.key
# REDIS_SSL_CERT_REQS=required

# ── Worker Authentication ───────────────────────────────────────
# Ed25519 keypair — auto-generated by make setup.
# WORKER_PUBLIC_KEY stays on the server.
# WORKER_PRIVATE_KEY is in worker.env — copy it to workers.
SERVER_ADDRESS=localhost
MAIN_SERVER_URL=http://${SERVER_ADDRESS}:5001
# API_BASE=http://${SERVER_ADDRESS}:5001/api
# WORKER_PUBLIC_KEY=

# ── Server URL configuration (set by make setup) ────────────────
# Protocol for worker callbacks: 'http' or 'https'
# SERVER_PROTOCOL=https

# Host port mapped to the nginx/frontend container (80 for HTTP, 443 for HTTPS)
# NGINX_PORT=80
# Host port for the TLS listener — the frontend enables 443 automatically when
# self-signed certs exist in certs/web/ (generated by make setup → HTTPS).
# HTTPS_PORT=443

# ── Worker Identity & Mode ──────────────────────────────────────
# RUNNING_AS_WORKER=true
# WORKER_GPU_ID=0

# ── Worker Sandbox Resources ────────────────────────────────────
# GPU_RAM_PER_TASK_GB=8
# CPU_RAM_PER_TASK_GB=8
# RESERVED_RAM_GB=4
# RESERVED_CPU_CORES=1
# RAM_CLAMP_FACTOR=1.05

# Compose-level caps applied to the celery_worker container:
# hard memory/CPU ceilings and no capabilities / no-new-privileges.
# WORKER_MEM_LIMIT=1g
# WORKER_CPU_LIMIT=2

# Comma-separated GPU device ids the eval worker may use. When set, each
# sandbox pins a specific device instead of requesting every GPU (count=-1).
# Without device IDs, all the machine's GPUs remain requestable.
# WORKER_GPU_IDS=0,1

# ── Worker HTTP Client (reports / downloads) ────────────────────
# WORKER_MAX_LOG_LINES=10000
# WORKER_REPORT_MAX_RETRIES=3
# WORKER_REPORT_TIMEOUT=10
# WORKER_DOWNLOAD_TIMEOUT=30

# ── Server-Sent Events (SSE) ────────────────────────────────────
# SSE_MAX_PER_USER=15
# SSE_MAX_GLOBAL=2000
# SSE_IDLE_TIMEOUT=1800
# SSE_LOG_TTL=86400
# SSE_LOG_MAX_LINES=10000

# ── Security ────────────────────────────────────────────────────
# Set True when serving behind HTTPS (enables secure cookies). Production
# default in docker-compose is true. Only keep false for isolated LAN HTTP.
# SECURE_COOKIES=true

# ── Admin Tools ─────────────────────────────────────────────────
# USER_SEARCH_LIMIT=500
# AUDIT_LOG_YIELD_PER=500

# Redis client connection timeouts (seconds)
# REDIS_SOCKET_CONNECT_TIMEOUT=5
# REDIS_SOCKET_TIMEOUT=5

# ── Backup ──────────────────────────────────────────────────────
# BACKUPS_DIR=/backups
# MIN_BACKUP_DISK_GB=1
# BACKUP_TIMEOUT=600

# ── Image Builder (Docker) ──────────────────────────────────────
# TASK_IMAGES_DIR=./backend/task_images
# MIN_BUILD_DISK_GB=5
# BUILD_LOCK_EXPIRY=3600

# ── Application Defaults ────────────────────────────────────────
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:80

# Flask debug mode (never true in production)
FLASK_DEBUG=false

# HuggingFace dataset cache directory
HF_CACHE_DIR=./backend/hf_cache

# Upload storage path
# UPLOAD_FOLDER=./backend/uploads

# Workspace directory for evaluation sandboxes
# LAVBENCH_WORKSPACE_DIR=./backend/workspace

# Celery worker concurrency (per worker node)
# CELERY_WORKER_CONCURRENCY=4

# Pagination
# DEFAULT_PER_PAGE=10
# MAX_PER_PAGE=100

# Cache TTL (seconds)
# CACHE_TIMEOUT=300

# Task metadata defaults
# DEFAULT_TIME_LIMIT_SEC=300
# DEFAULT_RAM_LIMIT_MB=8192
# DEFAULT_PUBLIC_EVAL_PERCENTAGE=30

# Grace period after challenge deadline (seconds)
# DEADLINE_GRACE_PERIOD_SECONDS=60

# ── Logging ────────────────────────────────────────────────────
# Directory for application logs (rotated daily, kept 6 days)
# LOG_DIR=/app/logs

# URL for remote workers to ship logs (leave empty to disable)
# WORKER_LOG_SHIP_URL=

# ── Gunicorn (server) ──────────────────────────────────────────
# Max requests per worker before restart (prevents memory leaks)
# GUNICORN_MAX_REQUESTS=10000
# GUNICORN_MAX_REQUESTS_JITTER=2000
# File descriptor limit (for 300+ concurrent users)
# GUNICORN_ULIMIT_NOFILE=65536
