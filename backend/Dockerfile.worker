FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . ./
COPY worker-entrypoint.sh .
RUN chmod +x worker-entrypoint.sh

# Celery console scripts don't put the cwd on sys.path (Python 3.12+), so
# top-level imports like `utils.sse_utils` fail in the worker process without this.
ENV PYTHONPATH=/app
ENV HOME=/app

# Run as a dedicated non-root user (uid 10001). Docker-socket access for sandbox
# orchestration is granted at deploy time via --group-add (see deploy-worker.sh).
RUN useradd --system --uid 10001 --no-create-home lavbench \
    && mkdir -p /var/lib/lavbench/task_images /var/lib/lavbench/workspace /var/lib/lavbench/hf_cache \
    && chown -R lavbench:lavbench /app /var/lib/lavbench

USER lavbench

CMD ["./worker-entrypoint.sh"]
